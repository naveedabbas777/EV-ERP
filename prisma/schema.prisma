generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  status      String   @default("active")
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  regions     Region[]
  dealers     Dealer[]
  products    Product[]
  warehouses  Warehouse[]
  auditLogs   AuditLog[]
  notifications Notification[]
  approvalRequests ApprovalRequest[]
  stockTransfers  StockTransfer[]
  accounts Account[]
  vendors Vendor[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders PurchaseOrder[]
  expenses Expense[]
  employees Employee[]
  sales Sale[]
  orders Order[]
  payments Payment[]
  returnRequests ReturnRequest[]
  showrooms Showroom[]
  showroomSales ShowroomSale[]
  showroomPayments ShowroomPayment[]
}

model User {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email          String
  name           String
  passwordHash   String
  isActive       Boolean     @default(true)
  dealerId       String?
  showroomId     String?
  attributes     Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  userRoles      UserRole[]
  dealer         Dealer?     @relation("DealerUsers", fields: [dealerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  showroom       Showroom?   @relation(fields: [showroomId, dealerId, organizationId], references: [id, dealerId, organizationId], onDelete: Restrict)
  auditLogs      AuditLog[]
  notifications  Notification[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([dealerId, showroomId])
}

model Role {
  id            String      @id @default(cuid())
  name          String
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userRoles     UserRole[]
  rolePermissions RolePermission[]

  @@unique([name])
}

model Permission {
  id           String     @id @default(cuid())
  key          String     @unique
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  rolePermissions RolePermission[]
}

model UserRole {
  id            String   @id @default(cuid())
  userId        String
  roleId        String
  assignedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
}

model Region {
  id             String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  code           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  dealers        Dealer[]
  employees      Employee[]

  @@unique([organizationId, code])
}

model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employees   Employee[]
}

model Employee {
  id             String       @id @default(cuid())
  organizationId  String
  departmentId   String?
  regionId       String?
  employeeCode   String       @unique
  firstName      String
  lastName       String
  email          String?
  phone          String?
  designation    String?
  status         String       @default("active")
  baseSalary     Decimal?     @db.Decimal(18, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  region         Region?     @relation(fields: [regionId], references: [id], onDelete: SetNull)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  salaries       Salary[]
  showroomId     String?
  showroom       Showroom?    @relation(fields: [showroomId, organizationId], references: [id, organizationId], onDelete: Restrict)
}

model Dealer {
  id                    String           @id @default(cuid())
  organizationId         String
  regionId              String?
  registrationNumber    String           @unique
  name                  String
  contactPerson         String?
  contactEmail          String?
  phone                 String?
  address               String?
  status                String           @default("active")
  creditLimit           Decimal?         @db.Decimal(18, 2)
  outstandingBalance    Decimal          @default(0) @db.Decimal(18, 2)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  region                Region?          @relation(fields: [regionId], references: [id], onDelete: SetNull)
  assignments           DealerAssignment[]
  sales                 Sale[]
  payments              Payment[]
  orders                Order[]
  returnRequests        ReturnRequest[]
  showrooms             Showroom[]
  users                 User[]           @relation("DealerUsers")
  showroomSales         ShowroomSale[]
  showroomPayments      ShowroomPayment[]

  @@unique([id, organizationId])
}

model Showroom {
  id             String      @id @default(cuid())
  organizationId String
  dealerId       String
  name           String
  code           String
  address        String?
  phone          String?
  email          String?
  status         String      @default("active")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dealer         Dealer       @relation(fields: [dealerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  warehouse      Warehouse?
  users          User[]
  employees      Employee[]
  sales          Sale[]
  orders         Order[]
  payments       Payment[]
  returnRequests ReturnRequest[]
  retailSales    ShowroomSale[]
  retailPayments ShowroomPayment[]
  expenses       Expense[]

  @@unique([id, organizationId])
  @@unique([id, dealerId, organizationId])
  @@unique([dealerId, code])
  @@index([organizationId, dealerId, status])
}

model DealerAssignment {
  id          String   @id @default(cuid())
  dealerId    String
  dealer      Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  assignedTo  String?
  role        String?
  createdAt   DateTime @default(now())
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String
  description String?
  products    Product[]
}

model Product {
  id             String           @id @default(cuid())
  organizationId  String
  categoryId     String?
  sku            String           @unique
  name           String
  description    String?
  purchasePrice  Decimal          @db.Decimal(18, 2)
  dealerPrice    Decimal          @db.Decimal(18, 2)
  retailPrice    Decimal          @db.Decimal(18, 2)
  imageUrl       String?
  specs          Json?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventory      Inventory[]
  saleItems      SaleItem[]
  showroomSaleItems ShowroomSaleItem[]
  returnItems    ReturnItem[]
  stockTransfers StockTransfer[]
}

model Warehouse {
  id             String      @id @default(cuid())
  organizationId  String
  name           String
  code           String      @unique
  location       String?
  type           String      @default("company")
  showroomId     String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inventories    Inventory[]
  showroom      Showroom?   @relation(fields: [showroomId, organizationId], references: [id, organizationId], onDelete: Restrict)
  stockMovements StockMovement[]
  outboundTransfers StockTransfer[] @relation("warehouseOutboundTransfers")
  inboundTransfers  StockTransfer[] @relation("warehouseInboundTransfers")

  @@unique([showroomId, organizationId])
}

model Inventory {
  id              String        @id @default(cuid())
  organizationId   String
  productId       String
  warehouseId     String
  quantity        Int           @default(0)
  reservedStock   Int           @default(0)
  reorderLevel    Int           @default(0)
  updatedAt       DateTime      @updatedAt

  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId])
}

model ApprovalRequest {
  id            String   @id @default(cuid())
  organizationId String
  entityType    String
  entityId      String
  referenceNo   String?
  requestedBy   String?
  approverName  String?
  currentStatus String   @default("pending")
  comments      String?
  createdAt     DateTime @default(now())
  reviewedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, currentStatus])
}

model StockTransfer {
  id              String    @id @default(cuid())
  organizationId   String
  productId       String
  fromWarehouseId String
  toWarehouseId   String
  quantity        Int
  referenceNo     String    @unique
  status          String    @default("pending")
  notes           String?
  createdAt       DateTime  @default(now())
  approvedAt      DateTime?
  approvedBy      String?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromWarehouse   Warehouse    @relation("warehouseOutboundTransfers", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse     Warehouse    @relation("warehouseInboundTransfers", fields: [toWarehouseId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
}

model StockMovement {
  id           String   @id @default(cuid())
  warehouseId   String
  productId    String?
  type         String
  quantity     Int
  reason       String?
  referenceNo  String?
  createdAt    DateTime @default(now())

  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
}

model Sale {
  id             String      @id @default(cuid())
  organizationId  String
  dealerId       String
  showroomId     String?
  invoiceNumber   String      @unique
  saleDate       DateTime    @default(now())
  totalAmount    Decimal     @db.Decimal(18, 2)
  status         String      @default("pending")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  dealer         Dealer      @relation(fields: [dealerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  showroom       Showroom?   @relation(fields: [showroomId, dealerId, organizationId], references: [id, dealerId, organizationId], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items          SaleItem[]
  payments       Payment[]

  @@unique([id, dealerId, organizationId])
}

model SaleItem {
  id           String   @id @default(cuid())
  saleId       String
  productId    String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(18, 2)
  discount     Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount  Decimal  @db.Decimal(18, 2)

  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Order {
  id             String      @id @default(cuid())
  organizationId  String
  dealerId       String?
  showroomId     String?
  orderNumber    String      @unique
  status         String      @default("pending")
  totalAmount    Decimal     @db.Decimal(18, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items          OrderItem[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dealer         Dealer?      @relation(fields: [dealerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  showroom       Showroom?    @relation(fields: [showroomId, dealerId, organizationId], references: [id, dealerId, organizationId], onDelete: Restrict)
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(18, 2)
  totalAmount Decimal  @db.Decimal(18, 2)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  dealerId       String
  showroomId     String?
  saleId         String?
  paymentNumber  String   @unique
  amount         Decimal  @db.Decimal(18, 2)
  status         String   @default("pending")
  paymentMethod  String?
  referenceNo    String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dealer         Dealer   @relation(fields: [dealerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  showroom       Showroom? @relation(fields: [showroomId, dealerId, organizationId], references: [id, dealerId, organizationId], onDelete: Restrict)
  sale           Sale?    @relation(fields: [saleId, dealerId, organizationId], references: [id, dealerId, organizationId], onDelete: Restrict)
}

model Account {
  id          String       @id @default(cuid())
  organizationId String
  name        String
  type        String
  balance     Decimal      @default(0) @db.Decimal(18, 2)
  createdAt   DateTime     @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entries     LedgerEntry[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model LedgerEntry {
  id          String   @id @default(cuid())
  accountId   String
  amount      Decimal  @db.Decimal(18, 2)
  entryType   String
  note        String?
  createdAt   DateTime @default(now())

  account     Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
}

model ReturnRequest {
  id             String       @id @default(cuid())
  organizationId String
  dealerId       String
  showroomId     String?
  status         String       @default("pending")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dealer         Dealer       @relation(fields: [dealerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  showroom       Showroom?    @relation(fields: [showroomId, dealerId, organizationId], references: [id, dealerId, organizationId], onDelete: Restrict)
  items          ReturnItem[]
}

model ReturnItem {
  id             String        @id @default(cuid())
  requestId      String
  productId      String
  quantity       Int
  defectReason   String?
  inspectedQty   Int?
  inspectionNote String?

  request        ReturnRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Vendor {
  id          String   @id @default(cuid())
  organizationId String
  name        String
  contactName String?
  phone       String?
  email       String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model PurchaseRequisition {
  id             String     @id @default(cuid())
  organizationId String
  vendorName     String?
  requisitionNo  String     @unique
  status         String     @default("draft")
  totalAmount    Decimal    @db.Decimal(18, 2)
  createdAt      DateTime   @default(now())
  items          PurchaseRequisitionItem[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model PurchaseRequisitionItem {
  id          String   @id @default(cuid())
  requisitionId String
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(18, 2)
  totalAmount Decimal  @db.Decimal(18, 2)

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  organizationId String
  orderNo     String   @unique
  vendorName  String
  totalAmount Decimal  @db.Decimal(18, 2)
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model Attendance {
  id          String   @id @default(cuid())
  employeeId  String
  date        DateTime
  status      String
  createdAt   DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id          String   @id @default(cuid())
  employeeId  String
  leaveType   String
  fromDate    DateTime
  toDate      DateTime
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Salary {
  id          String   @id @default(cuid())
  employeeId  String
  month       String
  amount      Decimal  @db.Decimal(18, 2)
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
}

model Expense {
  id          String   @id @default(cuid())
  organizationId String
  showroomId     String?
  title       String
  amount      Decimal  @db.Decimal(18, 2)
  category    String
  status      String   @default("approved")
  createdAt   DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  showroom     Showroom? @relation(fields: [showroomId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId])
  @@index([showroomId])
}

model ShowroomSale {
  id             String      @id @default(cuid())
  organizationId String
  dealerId       String
  showroomId     String
  invoiceNumber  String      @unique
  customerName   String?
  customerPhone  String?
  totalAmount    Decimal     @db.Decimal(18, 2)
  paidAmount     Decimal     @default(0) @db.Decimal(18, 2)
  createdBy      String?
  createdAt      DateTime    @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dealer         Dealer       @relation(fields: [dealerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  showroom       Showroom     @relation(fields: [showroomId, dealerId, organizationId], references: [id, dealerId, organizationId], onDelete: Restrict)
  items          ShowroomSaleItem[]
  payments       ShowroomPayment[]

  @@unique([id, organizationId, dealerId, showroomId])
  @@index([organizationId, dealerId, showroomId, createdAt])
}

model ShowroomSaleItem {
  id             String      @id @default(cuid())
  saleId         String
  productId      String
  quantity       Int
  unitPrice      Decimal     @db.Decimal(18, 2)
  totalAmount    Decimal     @db.Decimal(18, 2)

  sale           ShowroomSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
}

model ShowroomPayment {
  id             String       @id @default(cuid())
  organizationId String
  dealerId       String
  showroomId     String
  saleId         String
  amount         Decimal      @db.Decimal(18, 2)
  paymentMethod  String
  referenceNo    String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dealer         Dealer       @relation(fields: [dealerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  showroom       Showroom     @relation(fields: [showroomId, dealerId, organizationId], references: [id, dealerId, organizationId], onDelete: Restrict)
  sale           ShowroomSale @relation(fields: [saleId, organizationId, dealerId, showroomId], references: [id, organizationId, dealerId, showroomId], onDelete: Restrict)

  @@index([organizationId, dealerId, showroomId, createdAt])
}

model AuditLog {
  id            String      @id @default(cuid())
  organizationId String
  userId        String?
  action        String
  entityType    String
  entityId      String?
  details       Json?
  createdAt     DateTime    @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id            String      @id @default(cuid())
  organizationId String
  userId        String?
  title         String
  body          String
  readAt        DateTime?
  createdAt     DateTime    @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}
